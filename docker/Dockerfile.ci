# ── Stage 1: restore + build ─────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /repo

COPY global.json .
COPY Directory.Build.props .
COPY Gaku.sln .

COPY src/Gaku.Domain/Gaku.Domain.csproj                             src/Gaku.Domain/
COPY src/Gaku.Application/Gaku.Application.csproj                   src/Gaku.Application/
COPY src/Gaku.Infrastructure/Gaku.Infrastructure.csproj             src/Gaku.Infrastructure/
COPY tests/Gaku.Domain.Tests/Gaku.Domain.Tests.csproj               tests/Gaku.Domain.Tests/
COPY tests/Gaku.Application.Tests/Gaku.Application.Tests.csproj     tests/Gaku.Application.Tests/
COPY tests/Gaku.Infrastructure.Tests/Gaku.Infrastructure.Tests.csproj tests/Gaku.Infrastructure.Tests/

RUN dotnet restore Gaku.sln

COPY src/ src/
COPY tests/ tests/

RUN dotnet build src/Gaku.Domain/Gaku.Domain.csproj \
        -c Release --no-restore \
    && dotnet build src/Gaku.Application/Gaku.Application.csproj \
        -c Release --no-restore \
    && dotnet build src/Gaku.Infrastructure/Gaku.Infrastructure.csproj \
        -c Release --no-restore \
    && dotnet build tests/Gaku.Domain.Tests/Gaku.Domain.Tests.csproj \
        -c Release --no-restore \
    && dotnet build tests/Gaku.Application.Tests/Gaku.Application.Tests.csproj \
        -c Release --no-restore \
    && dotnet build tests/Gaku.Infrastructure.Tests/Gaku.Infrastructure.Tests.csproj \
        -c Release --no-restore

# ── Stage 2: test runner ──────────────────────────────────────────────────────
FROM build AS test

RUN mkdir -p /TestResults/domain /TestResults/application /TestResults/infrastructure

RUN dotnet test tests/Gaku.Domain.Tests/Gaku.Domain.Tests.csproj \
        -c Release --no-build \
        --logger "junit;LogFilePath=/TestResults/domain/junit.xml" \
        --results-directory /TestResults/domain \
    ; dotnet test tests/Gaku.Application.Tests/Gaku.Application.Tests.csproj \
        -c Release --no-build \
        --logger "junit;LogFilePath=/TestResults/application/junit.xml" \
        --results-directory /TestResults/application \
    ; dotnet test tests/Gaku.Infrastructure.Tests/Gaku.Infrastructure.Tests.csproj \
        -c Release --no-build \
        --logger "junit;LogFilePath=/TestResults/infrastructure/junit.xml" \
        --results-directory /TestResults/infrastructure
