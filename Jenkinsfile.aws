// Pipeline for the Jenkins controller in AWS (infra/terraform/modules/jenkins-controller).

// Runs all unit tests off passed project.
//  layerLabel: label for the library/target
//  projectPatht: path to the csproject
def dotnetTest(String layerLabel, String projectPath) {
    sh """
        docker run --name ${env.CONTAINER}-${layerLabel} \\
            --entrypoint dotnet \\
            ${env.CI_IMAGE} \\
            test ${projectPath} \\
                -c Release --no-build \\
                --logger "junit;LogFilePath=/TestResults/${layerLabel}/junit.xml" \\
                --results-directory /TestResults/${layerLabel}
    """
}

// Get JUnit test results by layerLabel inside the CI container into the workspace.
// Pass the result to Jenkins build record.
//  layerLabel: label for the library/target
def collectTestResults(String layerLabel) {
    sh """
        mkdir -p ${env.TEST_RESULTS}/${layerLabel}
        docker cp ${env.CONTAINER}-${layerLabel}:/TestResults/${layerLabel}/junit.xml \\
            ${env.TEST_RESULTS}/${layerLabel}/junit.xml || true
        docker rm -f ${env.CONTAINER}-${layerLabel} || true
    """
    junit allowEmptyResults: true,
          testResults: "${env.TEST_RESULTS}/${layerLabel}/junit.xml"
}

pipeline {
    agent any

    // Polling, not a webhook: the controller accepts inbound traffic only from the
    // operator's network, so GitHub's webhook calls would be dropped.
    triggers {
        pollSCM('H/2 * * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        AWS_REGION    = "eu-central-1"
        ECR_REGISTRY  = "100731996173.dkr.ecr.eu-central-1.amazonaws.com"
        CLUSTER       = "gaku-staging"
        NAMESPACE     = "gaku"

        CI_IMAGE      = "gaku-ci:${env.BUILD_NUMBER}"
        CONTAINER     = "gaku-ci-${env.BUILD_NUMBER}"
        TEST_RESULTS  = "TestResults"
        API_IMAGE     = "gaku-api"
        WEB_IMAGE     = "gaku-web"
        MIGRATOR_IMAGE = "gaku-migrator"
        IMAGE_TAG     = "${env.BUILD_NUMBER}"

        // Trivy runs as a container. Digist changes together with .github/workflows/security-scan.yml.
        TRIVY         = "docker run --rm -v trivy-cache:/root/.cache -v /var/run/docker.sock:/var/run/docker.sock -v ${env.WORKSPACE}:/src:ro -w /src aquasec/trivy:0.69.3@sha256:bcc376de8d77cfe086a917230e818dc9f8528e3c852f7b1aff648949b6258d1c"
    }

    stages {

        stage('Environment Info') {
            steps {
                sh """
                    echo "WORKSPACE    = ${env.WORKSPACE}"
                    echo "BUILD_NUMBER = ${env.BUILD_NUMBER}"
                    uname -a
                    docker version --format 'Docker {{.Server.Version}}'
                    aws --version
                    aws sts get-caller-identity
                """
            }
        }

        // Every environment's values, so a broken production file fails before a staging deploy.
        stage('Lint Chart') {
            steps {
                sh """
                    for ENV in local staging production; do
                      helm lint --strict infra/k8s/gaku -f infra/k8s/gaku/values-\${ENV}.yaml
                    done
                """
            }
        }

        stage('Restore & Build') {
            steps {
                sh """
                    docker build \\
                        --target ci \\
                        --tag ${env.CI_IMAGE} \\
                        --file docker/Dockerfile \\
                        .
                """
            }
        }

        stage('Test — Domain') {
            steps { dotnetTest('domain', 'tests/Gaku.Domain.Tests/Gaku.Domain.Tests.csproj') }
            post { always { collectTestResults('domain') } }
        }

        stage('Test — Application') {
            steps { dotnetTest('application', 'tests/Gaku.Application.Tests/Gaku.Application.Tests.csproj') }
            post { always { collectTestResults('application') } }
        }

        stage('Test — Infrastructure') {
            steps { dotnetTest('infrastructure', 'tests/Gaku.Infrastructure.Tests/Gaku.Infrastructure.Tests.csproj') }
            post { always { collectTestResults('infrastructure') } }
        }

        stage('Test — Web') {
            steps { dotnetTest('web', 'tests/Gaku.Web.Tests/Gaku.Web.Tests.csproj') }
            post { always { collectTestResults('web') } }
        }

        stage('Docker Build') {
            steps {
                sh """
                    GIT_SHA=\$(git rev-parse HEAD)
                    BUILD_TS=\$(date -u +%Y-%m-%dT%H:%M:%SZ)
                    for target in api web migrator; do
                      case \$target in
                        api)      IMAGE=${env.API_IMAGE} ;;
                        web)      IMAGE=${env.WEB_IMAGE} ;;
                        migrator) IMAGE=${env.MIGRATOR_IMAGE} ;;
                      esac
                      # --pull, the images start from the current base images rather than ones cached on the controller.
                      docker build --pull \\
                        --build-arg GIT_COMMIT=\${GIT_SHA} \\
                        --build-arg BUILD_NUMBER=${env.IMAGE_TAG} \\
                        --build-arg BUILD_TIMESTAMP=\${BUILD_TS} \\
                        -f docker/Dockerfile --target \$target \\
                        -t \${IMAGE}:${env.IMAGE_TAG} -t \${IMAGE}:latest .
                    done
                """
            }
        }

        // Blocks the push on the findings trivy.yaml selects. Pull requests run the same scans in .github/workflows/security-scan.yml.
        stage('Security Scan') {
            steps {
                // Every image is scanned even if one fails along the way.
                sh """
                    status=0
                    for IMAGE in ${env.API_IMAGE} ${env.WEB_IMAGE} ${env.MIGRATOR_IMAGE}; do
                      ${env.TRIVY} image \${IMAGE}:${env.IMAGE_TAG} || status=1
                    done
                    exit \$status
                """
            }
        }

        // The login password is a 12-hour token containing instance profile through IMDS.
        // The ECR repositories are MUTABLE.
        stage('Push to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${env.AWS_REGION} \\
                      | docker login --username AWS --password-stdin ${env.ECR_REGISTRY}

                    for IMAGE in ${env.API_IMAGE} ${env.WEB_IMAGE} ${env.MIGRATOR_IMAGE}; do
                      for TAG in ${env.IMAGE_TAG} latest; do
                        docker tag  \${IMAGE}:\${TAG} ${env.ECR_REGISTRY}/\${IMAGE}:\${TAG}
                        docker push ${env.ECR_REGISTRY}/\${IMAGE}:\${TAG}
                      done
                    done
                """
            }
        }

        // The chart's pre-upgrade hook runs the migrations before the rollout.
        // A failed migration or rollout rolls the release back.
        stage('Deploy to Staging') {
            when { expression { env.BRANCH_NAME == null || env.BRANCH_NAME == 'master' } }
            steps {
                sh """
                    aws eks update-kubeconfig --name ${env.CLUSTER} --region ${env.AWS_REGION}

                    # The chart needs the namespace and gaku-secret; on a fresh cluster neither exists yet.
                    kubectl create namespace ${env.NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
                    kubectl apply -f infra/k8s/eks/staging/external-secret.yaml
                    kubectl wait --for=condition=Ready externalsecret/gaku-secret \\
                        -n ${env.NAMESPACE} --timeout=120s

                    helm upgrade --install gaku infra/k8s/gaku -n ${env.NAMESPACE} \\
                        -f infra/k8s/gaku/values-staging.yaml \\
                        --set-string image.tag=${env.IMAGE_TAG} \\
                        --set-string gitSha=\$(git rev-parse HEAD) \\
                        --rollback-on-failure --timeout 10m
                """
            }
            post {
                failure {
                    sh "kubectl logs job/db-migrate -n ${env.NAMESPACE} --tail=100 || true"
                }
            }
        }

        stage('Smoke Test') {
            when { expression { env.BRANCH_NAME == null || env.BRANCH_NAME == 'master' } }
            steps {
                sh "helm test gaku -n ${env.NAMESPACE} --logs"
                // The ALB takes time to provision on new cluster, try and wait up to 5 minutes.
                sh """
                    for i in \$(seq 30); do
                      ADDR=\$(kubectl get ingress gaku-web -n ${env.NAMESPACE} \\
                          -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                      [ -n "\$ADDR" ] && curl -sf --max-time 10 "http://\$ADDR/api/health" > /dev/null && break
                      if [ \$i -eq 30 ]; then
                        echo "ALB not answering after 5 minutes - is the load balancer controller installed?"
                        exit 1
                      fi
                      sleep 10
                    done
                    curl -sf --max-time 10 "http://\$ADDR/api/echo"
                """
            }
        }
    }

    post {
        always {
            sh "docker rmi --no-prune ${env.CI_IMAGE} || true"
        }
        failure {
            echo 'Build, push or deploy failed. Check the Test Results tab and the stage log.'
        }
    }
}
